{
  "name": "lares-app",
  "version": "0.3.0",
  "description": "An agent-native workspace for orchestrating AI agents across terminals, files, browsers, documents, and notebooks.",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,electron \"npm run dev:renderer\" \"node -e \\\"setTimeout(()=>process.exit(),3000)\\\" && npm run start\"",
    "dev:renderer": "vite --port 5173",
    "build:main": "node scripts/generate-memory-index-cli.mjs && tsc -p tsconfig.main.json && node scripts/copy-static-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "restart": "npm run build && npm run start",
    "test:renderer": "vitest run --config vitest.config.ts",
    "test:media": "npm run build:main && node dist/main/main/media-protocol.test.js",
    "test:supervisor": "npm run build:main && node scripts/run-main-tests.mjs",
    "test:plans": "npm run build:main && node dist/main/main/plans-data-layer.test.js && node dist/main/main/api-server-plans.test.js && node dist/main/main/api-server-plans-create.test.js && node dist/main/main/api-server-focus.test.js && node dist/main/main/plans-watcher.test.js && node dist/main/main/plans-legacy-drop-migration.test.js && node scripts/mcp-tools-plans.test.js",
    "analytics:snapshot": "npm run build:main && electron dist/main/main/analytics-export/analytics-snapshot-cli.js",
    "analytics:snapshot:fast": "electron dist/main/main/analytics-export/analytics-snapshot-cli.js",
    "test:analytics": "npm run build:main && node dist/main/main/context-overhead/overhead-dto.test.js && node dist/main/main/analytics-export/analytics-exporter.test.js && node dist/main/main/api-server-overhead-route.test.js",
    "fetch:mingit": "node scripts/fetch-mingit.mjs",
    "rebuild": "npm run rebuild:native",
    "rebuild:native": "node scripts/rebuild-native.js --arch=x64",
    "verify:native": "electron scripts/verify-native.cjs",
    "check:plan-versioning": "node scripts/check-plan-folder-versioning.mjs --check",
    "lint:edr": "node scripts/check-edr-patterns.mjs",
    "package:prepare": "npm run check:plan-versioning && npm run lint:edr && npm run build && npm run rebuild:native && npm run verify:native && npm run fetch:mingit && npm run verify:payloads",
    "pack": "npm run package:prepare && electron-builder --dir --win --x64 --config.npmRebuild=false --publish never && npm run verify:packaged-scripts && npm run verify:bundled-git",
    "dist": "npm run dist:win",
    "dist:win": "npm run package:prepare && electron-builder --win nsis --x64 --config.npmRebuild=false --publish never && npm run verify:packaged-scripts && npm run verify:bundled-git",
    "verify:payloads": "node scripts/verify-package-payloads.mjs",
    "verify:packaged-scripts": "node scripts/verify-packaged-scripts.mjs",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-package.ps1",
    "verify:bundled-node": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-bundled-node.ps1",
    "verify:bundled-git": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-bundled-git.ps1"
  },
  "build": {
    "appId": "com.lares.app",
    "productName": "Lares",
    "executableName": "Lares",
    "copyright": "Copyright © 2026 Edward Turk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "mcp-dashboard.js",
          "mcp-supervisor.js",
          "mcp-supervisor-poll.js",
          "mcp-team.js",
          "mcp-tools-orchestration.js",
          "mcp-tools-teams.js",
          "mcp-tools-comms.js",
          "mcp-tools-observability.js",
          "mcp-tools-plans.js",
          "mcp-tools-notebooks.js",
          "mcp-tools-checkpoints.js",
          "mcp-browser-tools.js",
          "mcp-browser-present-tools.js"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "third_party/git-for-windows/.staging/mingit",
        "to": "mingit"
      },
      {
        "from": "native/lares-native",
        "to": "native/lares-native",
        "filter": [
          "index.js",
          "index.d.ts",
          "package.json",
          "build/Release/lares_native.node"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/node-pty/**",
      "**/node_modules/@hyzyla/pdfium/**",
      "**/*.node"
    ],
    "icon": "assets/icon.ico",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Lares",
      "menuCategory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Lares-Setup-${version}-${arch}.${ext}"
    }
  },
  "overrides": {
    "@codemirror/search": "6.5.11"
  },
  "keywords": [
    "ai-agents",
    "agent-orchestration",
    "multi-agent",
    "agentic",
    "ai-workspace",
    "llm",
    "claude-code",
    "mcp",
    "electron",
    "developer-tools",
    "browser-automation",
    "notebooks"
  ],
  "author": "Edward Turk",
  "license": "Apache-2.0",
  "dependencies": {
    "@codemirror/autocomplete": "6.18.7",
    "@codemirror/commands": "6.5.0",
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/lang-python": "6.1.7",
    "@codemirror/language": "6.10.8",
    "@codemirror/state": "6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.26.4",
    "@datalayer/jupyter-react": "^2.0.7",
    "@hyzyla/pdfium": "2.1.13",
    "@jupyter/ydoc": "3.0.5",
    "@jupyterlab/services": "^7.5.6",
    "@milkdown/crepe": "7.21.2",
    "@milkdown/kit": "7.21.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@types/dompurify": "^3.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "2.1.1",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "diff": "9.0.0",
    "dompurify": "^3.3.3",
    "geotiff": "^3.0.5",
    "js-tiktoken": "^1.0.21",
    "jsonc-parser": "^3.3.1",
    "katex": "0.16.45",
    "leaflet": "^1.9.4",
    "lowlight": "3.3.0",
    "lucide-react": "^0.577.0",
    "mammoth": "1.12.0",
    "node-pty": "^1.1.0",
    "parse5": "^8.0.1",
    "proj4": "^2.20.8",
    "react-markdown": "9.0.3",
    "react-pdf": "^10.4.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "7.0.1",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shpjs": "^6.2.0",
    "sql.js": "^1.14.1",
    "string-width": "7.2.0",
    "unified": "11.0.5",
    "uuid": "^13.0.0",
    "wkx": "^0.5.0",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "y-codemirror.next": "0.3.5",
    "y-websocket": "2.0.4",
    "yjs": "13.6.30",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/shpjs": "^3.4.7",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "0.27.3",
    "framer-motion": "^12.35.2",
    "jsdom": "29.1.1",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "4.1.8",
    "zustand": "^5.0.11"
  }
}
