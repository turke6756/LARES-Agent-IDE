node_modules/
dist/
logs/
*.db
.env
process.exit()
*.log
*.vsix
vscode-extension/out/
release/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Private documentation — internal design/bug notes live under docs/internal/
# (ignored); docs/ root is public (curated launch docs). Anchored so it only
# ignores the internal subtree, never the public docs.
/docs/internal/

# Raw pressure-test dumps — kept locally, not shipped to the public repo.
experiments/

# Local-only working plans (repo-root dir only — anchored so it does NOT also
# ignore source under src/main/plans/, which is real committable code).
/plans/

# Automated backup files
*.bak.*

# Per-workspace runtime state (not part of repo template).
# `.lares/` is the live state-dir name; the `.dashboard/` twins stay because a
# not-yet-migrated (or rename-blocked) clone still carries the legacy dir.
.lares/.scaffold-versions.json
.lares/workers/
.lares/scripts/
.lares/pending-status.jsonl
.lares/usage/
.lares/*/.claude/.sysprompt-*.txt
.lares/*/.claude/scheduled_tasks.lock
.lares/main-crash.log
.dashboard/.scaffold-versions.json
.dashboard/workers/
.dashboard/scripts/
.dashboard/pending-status.jsonl
.dashboard/usage/
.dashboard/*/.claude/.sysprompt-*.txt
.dashboard/*/.claude/scheduled_tasks.lock
.dashboard/main-crash.log

# Internal agent state that must not ship in the public scaffold (anchored/specific)
/.lares/*/memory/
/.lares/cdp-trace.*.jsonl
/.lares/staging/
/.lares/*/staging/
/.dashboard/*/memory/
/.dashboard/cdp-trace.*.jsonl
/.dashboard/staging/
/.dashboard/*/staging/
# Frozen analytics exports — machine-local, timestamped, pruned by the exporter.
# Contains workspace-scoped analytics; never committable.
/.lares/analytics/
/.lares/*/plan-surface-eval-handoff.md
/.lares/*/.claude/settings.local.json
/.dashboard/analytics/
/.dashboard/*/plan-surface-eval-handoff.md
/.dashboard/*/.claude/settings.local.json

# >>> agentdashboard-research-store >>>
# WP-G — research store: inbox/ holds raw, untrusted, web-derived artifacts and
# must never be committed; cleared/ (reviewed) stays trackable. (Case A — no
# blanket /.lares/* ignore is in effect, so a single inbox/ rule suffices.
# Legacy `.dashboard` twin kept for unmigrated clones.)
/.lares/research/inbox/
/.dashboard/research/inbox/
# <<< agentdashboard-research-store <<<

# MCP config — generated per app launch, embeds a live API bearer token.
# It's a build artifact (the app rewrites it on every supervisor launch), so it
# must never be committed. The app regenerates it locally on each machine.
.mcp.json
**/.mcp.json

# Machine-local launchers — these hardcode an absolute developer path, so they
# are useless to anyone else cloning the repo. Keep your own copy locally.
/AgentDashboard.bat

# Local scratch — throwaway files from spikes and manual pokes.
/hello.py
/proposed
/spike-hello-world.md

# Machine-local runtime descriptor (absolute paths) — generated at launch
/.lares/installation.json
/.dashboard/installation.json

# Bundled MinGit staging (WP-G0.5) — the fetched/verified Git-for-Windows payload
# is downloaded by scripts/fetch-mingit.mjs in release CI and packaged via
# build.extraResources; it is NEVER checked into git. git-runtime's dev fallback
# resolves the bundled git.exe out of this same path.
/third_party/git-for-windows/.staging/
